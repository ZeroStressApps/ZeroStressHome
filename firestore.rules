rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() && request.auth.uid == userId;
    }

    match /homes/{homeId} {
      // El código de invitación es el ID del documento.
      // Solo usuarios autenticados pueden acceder.
      allow create: if signedIn()
        && request.resource.data.members.hasAny([request.auth.uid]);
      allow read: if signedIn()
        && resource.data.members.hasAny([request.auth.uid]);
      allow update: if signedIn()
        && resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members.hasAll([request.auth.uid]);

      match /reservations/{reservationId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);
      }

      match /expenseMonths/{monthId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);

        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid])
          && request.resource.data.paidBy == request.auth.uid;

        allow delete: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);
      }

      match /expenses/{expenseId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);

        allow create: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid])
          && request.resource.data.paidBy == request.auth.uid;

        allow delete: if signedIn()
          && resource.data.paidBy == request.auth.uid
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);

        allow update: if signedIn()
          && resource.data.paidBy == request.auth.uid
          && request.resource.data.paidBy == request.auth.uid
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);
      }
    }
  }
}
