rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() && request.auth.uid == userId;
    }

    match /homes/{homeId} {
      // Crear una casa: el creador debe aparecer como miembro.
      allow create: if signedIn()
        && request.resource.data.members.hasAny([request.auth.uid]);

      // Leer una casa: sus miembros pueden leerla y, además, una persona
      // autenticada que conozca el código puede leerla para poder unirse.
      allow read: if signedIn()
        && (resource.data.members.hasAny([request.auth.uid])
            || resource.data.inviteCode == homeId);

      // Un miembro puede actualizar la casa normalmente.
      // Una persona que entra con el código solo puede añadirse a sí misma
      // y guardar su propio nombre.
      allow update: if signedIn()
        && (
          (resource.data.members.hasAny([request.auth.uid])
           && request.resource.data.members.hasAll([request.auth.uid]))
          ||
          (resource.data.inviteCode == homeId
           && !resource.data.members.hasAny([request.auth.uid])
           && request.resource.data.members.hasAny([request.auth.uid])
           && request.resource.data.members.hasAll(resource.data.members)
           && request.resource.data.members.size() == resource.data.members.size() + 1
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "memberNames"])
           && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]))
        );

      match /reservations/{reservationId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);
      }

      match /expenseMonths/{monthId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);

        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid])
          && request.resource.data.paidBy == request.auth.uid;

        allow delete: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);
      }

      match /expenses/{expenseId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);

        allow create: if signedIn()
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid])
          && request.resource.data.paidBy == request.auth.uid;

        allow delete: if signedIn()
          && resource.data.paidBy == request.auth.uid
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);

        allow update: if signedIn()
          && resource.data.paidBy == request.auth.uid
          && request.resource.data.paidBy == request.auth.uid
          && get(/databases/$(database)/documents/homes/$(homeId))
               .data.members.hasAny([request.auth.uid]);
      }
    }
  }
}
